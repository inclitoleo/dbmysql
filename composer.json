{
    "name": "inclitoleo/dbmysql",
    "description": "Simple, fast MySQL library for PHP. Raw SQL or query builder. Compatible with Laravel, CakePHP, and Symfony.",
    "type": "library",
    "keywords": [
        "mysql",
        "pdo",
        "query-builder",
        "laravel",
        "cakephp",
        "symfony"
    ],
    "homepage": "https://github.com/inclitoleo/dbmysql",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Inclitoleo\\Mysql\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inclitoleo\\Mysql\\Tests\\": "tests/",
            "Inclitoleo\\Mysql\\Tests\\Fixtures\\": "tests/fixtures/"
        }
    },
    "authors": [
        {
            "name": "LeoCosta",
            "email": "linclitoleo@yandex.com",
            "role": "developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "suggest": {
        "illuminate/support": "Laravel auto-discovery of QueryBuilder from config/database.php",
        "symfony/framework-bundle": "Wire QueryBuilder from DATABASE_URL",
        "cakephp/cakephp": "Build ConnectionConfig from CakePHP Datasources"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inclitoleo\\Mysql\\Laravel\\DbMysqlServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite=unit",
        "test-integration": "phpunit --testsuite=integration",
        "test-security": "phpunit --testsuite=security",
        "test-regression": "phpunit --testsuite=regression"
    }
}
