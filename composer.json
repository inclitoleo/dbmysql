{
    "name": "inclitoleo/dbmysql",
    "description": "Simple, fast and objective library for connecting and querying MySQL databases.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Inclitoleo\\Mysql\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inclitoleo\\Mysql\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "LeoCosta",
            "email": "linclitoleo@yandex.com",
            "role": "developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite=unit",
        "test-integration": "phpunit --testsuite=integration",
        "test-security": "phpunit --testsuite=security",
        "test-regression": "phpunit --testsuite=regression"
    }
}
